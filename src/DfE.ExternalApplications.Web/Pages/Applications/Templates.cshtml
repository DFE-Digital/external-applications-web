@page "/applications/templates"
@model DfE.ExternalApplications.Web.Pages.Applications.TemplatesModel

@{
}

<h1 class="govuk-heading-xl">Application Templates</h1>

<h2 class="govuk-heading-l">Templates</h2>

<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Template Version ID</th>
            <th scope="col" class="govuk-table__header">Template ID</th>
            <th scope="col" class="govuk-table__header">Template Version Number</th>
            <th scope="col" class="govuk-table__header">Action</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var template in Model.ApplicationTemplates)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@template.VersionId</td>
                <td class="govuk-table__cell">@template.Id</td>
                <td class="govuk-table__cell">@template.VersionNumber</td>
                <td class="govuk-table__cell"><a class="govuk-link" href="/applications?templateid=@template.Id">Applications</a></td>
            </tr>
        }
    </tbody>
</table>
